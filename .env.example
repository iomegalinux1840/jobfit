# JobFit reads provider credentials from the process environment.
# Keep real values in your shell or an ignored .env file; never commit them.

OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=

# Optional custom geocoder endpoint for distance filtering.
JOBFIT_GEOCODER_URL=
